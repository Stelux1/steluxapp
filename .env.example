# Leave DATABASE_URL empty to use the existing local SQLite database.
# Copy the Session pooler URL from Supabase > Connect > Direct.
# Remove [YOUR-PASSWORD] from the URL; enter the password below instead.
DATABASE_URL=
STELUX_DATABASE_PASSWORD=""
# If required, path to the CA certificate downloaded from Supabase settings.
STELUX_DATABASE_CA=
# Optional server profile: full (default) or welding-demo.
STELUX_RELEASE_PROFILE=full
# Local evaluation uses separate SQLite storage, never DATABASE_URL.
STELUX_DEMO_DATA_DIR=.data/welding-demo

# Cloud evaluation uses its own PostgreSQL database; never reuse the full one.
# Supply these privately at runtime (Docker) or in Shipvela's server build
# environment, which the Next build binds into its private server bundle.
# Never use VITE_ or NEXT_PUBLIC_ prefixes for these values.
STELUX_DEMO_DATABASE_URL=
STELUX_DEMO_DATABASE_PASSWORD=""
STELUX_DEMO_DATABASE_CA=
STELUX_PUBLIC_URL=
# Optional bind address. Cloud entry defaults to 0.0.0.0, local to 127.0.0.1.
STELUX_HOST=
